[mysqld]
# Observabilidade básica — não altera o comportamento de performance do banco.
slow_query_log = 1
slow_query_log_file = /var/lib/mysql/slow.log
long_query_time = 1

# Demais parâmetros (innodb_buffer_pool_size, max_connections, etc.) ficam
# nos defaults de propósito. Ajuste quando um gargalo apontar pra eles.
